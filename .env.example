# ---------- Client (NEXT_PUBLIC_*) ----------

# Public site URL. Used in metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public API base URL the browser hits.
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Optional analytics ID. Leave blank to disable.
NEXT_PUBLIC_ANALYTICS_ID=""

# ---------- Server (do not expose to the browser) ----------

# Postgres connection string used by Prisma.
# Local example: postgresql://postgres:postgres@localhost:5432/next2point0
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next2point0"

# Secret used by Auth.js to sign session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Public origin Auth.js redirects to.
AUTH_URL="http://localhost:3000"

# Optional GitHub OAuth provider. Leave blank to disable the GitHub button.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
